rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Uploaded PDF Documents, Images, and Excel Files
    match /uploads/{allPaths=**} {
      // Anyone can view/download uploaded documents & reports
      allow read: if true;
      
      // Only authenticated Admins can upload, modify, or delete files
      allow write: if request.auth != null;
    }

    // Default rule for all other storage paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
